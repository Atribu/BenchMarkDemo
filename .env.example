# Optional overrides. Leave commented to use each provider's defaults.
# Locale does not change the outbound IP country.
# OTA_MARKET=uk
# OTA_BROWSER_CHANNEL=chromium
# OTA_USE_STEALTH=false
# OTA_PROXY_URL=http://username:password@host:port
# Anonymous OTA cookies/local storage are kept locally, never in Git.
# OTA_PERSIST_SESSIONS=false
# OTA_SESSION_DIR=/absolute/private/path
# Set false to disable Google Hotels secondary hotel-level observations.
# OTA_GOOGLE_HOTELS=false
# Set false to disable separately labelled Booking/Expedia/TUI offers from HolidayCheck.
# OTA_HOLIDAYCHECK_SECONDARY=false
# OTA_DEBUG=true

# Optional managed Google Hotels source. No API call without explicit enablement.
# Enable only on a free account with no funded balance/auto-recharge for a free trial.
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
# Persistent private volume. App caps attempts at 20/day and 200/month (UTC).
# These limits do not include activity outside this app and are not a billing guarantee.
# BENCHMARK_STATE_DIR=/var/lib/benchmark

# Required in production. Serve behind HTTPS; use one Node process/replica.
BENCHMARK_AUTH_USER=
# Use a unique random ASCII password of at least 20 characters.
BENCHMARK_AUTH_PASSWORD=
# Exact browser-visible origin behind a reverse proxy. This is the main panel
# origin when Benchmark is mounted at /benchmark, e.g. http://127.0.0.1:3000
# locally or https://panel.example.com in production.
# Development also accepts the benchmark server's directly opened local origin;
# production accepts only this configured origin.
BENCHMARK_PUBLIC_ORIGIN=

# Optional main-panel return address. The same-origin root is used when empty.
# NEXT_PUBLIC_MAIN_PANEL_URL=https://panel.example.com

# EUR için de, GBP için uk varsayılandır. Gerekirse açıkça değiştirin.
BOOKING_MARKET=de
# Tercihen hedef pazardaki sabit/residential HTTPS veya SOCKS5 proxy.
BOOKING_PROXY_URL=
BOOKING_BROWSER_CHANNEL=chrome
BOOKING_USE_STEALTH=true

# EUR sorgusunda Almanya, GBP sorgusunda UK yereli otomatik secilir.
EXPEDIA_PROXY_URL=
# Uretimde varsayilan true, yerel gorunur tarayici testi icin false yapilabilir.
# EXPEDIA_HEADLESS=true

LOVEHOLIDAYS_MARKET=uk
LOVEHOLIDAYS_PROXY_URL=

ONTHEBEACH_MARKET=uk
ONTHEBEACH_PROXY_URL=

# Port Nature icin Rusya hotel-only cikisi. Bosken OTA_PROXY_URL kullanilir.
PEGASTOUR_RU_PROXY_URL=

# Occupancy is fixed to 1 room / 2 adults across every collector.
